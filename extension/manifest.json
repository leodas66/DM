{
  "manifest_version": 3,
  "name": "dm",
  "version": "0.1.0-dev",
  "description": "Send downloads to the local dm daemon.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "dist/popup.html",
    "default_title": "dm"
  },
  "options_ui": {
    "page": "dist/options.html",
    "open_in_tab": true
  }
}
