{
  "manifest_version": 3,
  "name": "DM",
  "version": "0.2.1",
  "description": "Send browser downloads to the DM download manager.",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "tabs",
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DM"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
